LLM_PROVIDER=openai

# Only OpenAI is implemented today. Add other provider-specific keys only
# after the corresponding adapter exists under src/llm and LLM_PROVIDER
# points to that adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
DATA_DIR=./data
OUTPUT_DIR=./output
PROMPTS_DIR=./prompts
RESUME_TAILOR_LOG_LEVEL=info
